# Modèle de configuration — copier vers backend/.env et remplir avec les vraies valeurs.
# backend/.env ne doit JAMAIS être commité (voir .gitignore).

# ===================== Base de données =====================
POSTGRES_DB=myappdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Connexion de l'application elle-même. SPRING_DATASOURCE_PASSWORD est
# OBLIGATOIRE : application.properties n'a volontairement aucune valeur de repli
# (une valeur committée est un secret publié, et une variable oubliée en
# production connecterait la base avec un mot de passe public).
# Nécessaire pour lancer en natif depuis backend/ ; en conteneur, docker-compose
# fournit déjà ces variables.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/myappdb
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=change-me

# ===================== JWT =====================
# Obligatoire. Minimum 64 caractères (HMAC-SHA512).
# Générer avec : openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=6000000

# Mettre true uniquement pour une démonstration locale, jamais en préproduction
# ou en production. docker-compose.yml l'active explicitement pour le poste local.
APP_DEMO_DATA_ENABLED=false

# ===================== SMTP (Brevo) =====================
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Expéditeur des e-mails (doit être un expéditeur vérifié chez Brevo)
#
# ATTENTION — blocage constaté le 2026-09-08 : le domaine inpg.sn a de vrais MX
# Microsoft 365 et un SPF en « -all » qui n'autorise PAS Brevo. Tout message envoyé
# via Brevo en se présentant comme @inpg.sn est donc rejeté ou mis en quarantaine
# côté destinataire : le candidat ne reçoit jamais rien, sans erreur côté serveur.
#
# Deux sorties possibles, à trancher avant la mise en production :
#   1. ajouter Brevo au SPF (et publier la clé DKIM Brevo) dans le DNS d'inpg.sn ;
#   2. renoncer à Brevo et pointer MAIL_HOST vers le SMTP Microsoft 365 d'inpg.sn.
# En développement, on contourne avec une adresse d'un domaine vérifié chez Brevo —
# ce contournement n'est pas acceptable en production (les candidats recevraient
# leurs convocations depuis une adresse personnelle).
APP_MAIL_FROM=no-reply@gmail.com

# Boîte de réception des messages de contact du site public
APP_ADMISSION_EMAIL=no-reply@gmail.com

# Boîte de réception de l'équipe d'accréditation des écoles de formation (TDR §F)
APP_ACCREDITATION_EMAIL=no-reply@gmail.com

# ===================== Certificats =====================
# Facultatif. URL publique du frontend, encodée dans le QR code du certificat
# (lien de vérification). Par défaut : http://localhost:4200.
APP_FRONTEND_URL=

# OBLIGATOIRE. Clé HMAC de signature des certificats, distincte de JWT_SECRET
# (générer avec : openssl rand -base64 48). Le serveur refuse de démarrer sans elle.
# Environnement existant où elle recopiait JWT_SECRET : mettre une nouvelle valeur ici et
# l'ancienne dans CERTIFICAT_SIGNATURE_SECRETS_ANCIENS, pour que les certificats déjà
# imprimés restent vérifiables.
CERTIFICAT_SIGNATURE_SECRET=
CERTIFICAT_SIGNATURE_SECRETS_ANCIENS=

# ===================== Comptes initiaux =====================
# Créés au premier démarrage s'ils n'existent pas (base neuve de production : sinon aucun
# compte). Jamais modifiés ensuite. Mot de passe commun, à changer à la première connexion.
APP_INIT_PASSWORD=
APP_INIT_ADMISSION_EMAIL=
APP_INIT_PEDAGOGIE_EMAIL=
APP_INIT_EVALUATEUR_EMAIL=

# ===================== Limitation de débit =====================
# Facultatif. Requêtes autorisées par adresse et par fenêtre sur les routes ouvertes à tous
# (inscription : 1 h ; question publique : 15 min ; vérification de certificat : 10 min).
# En recette, tous les visiteurs partagent une adresse : relever la valeur pour une campagne d'essais.
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_INSCRIPTION=10
APP_RATE_LIMIT_QUESTION=5
APP_RATE_LIMIT_VERIFICATION_CERTIFICAT=30
