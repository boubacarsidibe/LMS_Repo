        <mxCell id="alumni-profil" value="&lt;b&gt;AlumniProfil&lt;/b&gt; [A CONSTRUIRE]&lt;hr&gt;id : Long&lt;br&gt;etudiant : Etudiant (@MapsId)&lt;br&gt;posteActuel : String&lt;br&gt;entreprise : String&lt;br&gt;secteurActivite : String&lt;br&gt;visible : boolean&lt;hr&gt;Suivre le patron @MapsId de&lt;br&gt;Candidat/Etudiant : un alumni EST&lt;br&gt;un etudiant, pas une nouvelle&lt;br&gt;identite." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="500" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="situation-pro" value="&lt;b&gt;SituationProfessionnelle&lt;/b&gt; [A CONSTRUIRE]&lt;hr&gt;id : Long&lt;br&gt;alumniProfil : AlumniProfil&lt;br&gt;intitulePoste : String&lt;br&gt;dateDebut : LocalDate&lt;br&gt;dateFin : LocalDate (nullable)&lt;hr&gt;Historique : plusieurs lignes par&lt;br&gt;alumni, pas un simple champ.&lt;br&gt;Cf. principe de ReleveLigne :&lt;br&gt;figer une valeur n'est pas la&lt;br&gt;recalculer." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="500" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="forum-sujet" value="&lt;b&gt;ForumSujet&lt;/b&gt;&lt;hr&gt;id : Long&lt;br&gt;auteur : User&lt;br&gt;titre : String&lt;br&gt;promotion : Promotion&lt;hr&gt;Deja utilise par l'espace etudiant.&lt;br&gt;Reutiliser plutot que dupliquer :&lt;br&gt;prevoir un sujet visible cote&lt;br&gt;alumni (portee elargie), pas un&lt;br&gt;second systeme de forum." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="500" width="280" height="150" as="geometry" />
