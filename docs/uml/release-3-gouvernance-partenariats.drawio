<mxfile host="app.diagrams.net">
  <diagram name="Release 3 - Gouvernance et partenariats" id="release-3-gp">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== LEGENDE ===================== -->
        <mxCell id="legende" value="Legende" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legende-nouvelle" value="Classe nouvelle (cette session)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legende-existant" value="Classe existante reutilisee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legende-afaire" value="A construire (epic future)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== EPIC F - ACCREDITATION DES ECOLES ===================== -->
        <mxCell id="titre-epicF" value="TDR section F - Accreditation des ecoles de formation" style="text;html=1;fontStyle=1;fontSize=16;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ecole-formation" value="&lt;b&gt;EcoleFormation&lt;/b&gt; [NOUVEAU]&lt;hr&gt;id (= id_user, @MapsId User)&lt;br&gt;nomEcole : String&lt;br&gt;adresse : String&lt;br&gt;telephone : String&lt;br&gt;siteWeb : String&lt;br&gt;dateCreation : LocalDate" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="demande-accreditation" value="&lt;b&gt;DemandeAccreditation&lt;/b&gt; [NOUVEAU]&lt;hr&gt;id : Long&lt;br&gt;ecole : EcoleFormation&lt;br&gt;statut : SOUMISE|EN_COURS_EVALUATION|ACCREDITE|REJETE&lt;br&gt;dateSoumission / dateDecision&lt;br&gt;motifRejet / commentaireEvaluation&lt;br&gt;evaluateur : User&lt;br&gt;pieces : List&amp;lt;PieceAccreditation&amp;gt;&lt;hr&gt;Une seule demande active a la fois&lt;br&gt;(index partiel V15, pas seulement applicatif)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="piece-accreditation" value="&lt;b&gt;PieceAccreditation&lt;/b&gt; [NOUVEAU]&lt;hr&gt;id : Long&lt;br&gt;typeDocument : enum&lt;br&gt;demande : DemandeAccreditation&lt;br&gt;fichierStocke : FichierStocke" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1040" y="80" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="fichier-stocke" value="&lt;b&gt;FichierStocke&lt;/b&gt; (recrutement) [REUTILISE]&lt;hr&gt;Meme enregistrement de fichier physique&lt;br&gt;deja utilise par PieceJustificative." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1040" y="220" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="critere-accreditation" value="&lt;b&gt;CritereAccreditation&lt;/b&gt; [NOUVEAU]&lt;hr&gt;id : Long&lt;br&gt;libelle : String&lt;br&gt;description : String&lt;br&gt;actif : boolean&lt;hr&gt;Referentiel consulte par l'evaluateur,&lt;br&gt;pas de grille de notation structuree&lt;br&gt;(non specifiee par le TDR)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="260" height="150" as="geometry" />
        </mxCell>

        <mxCell id="ecole-controller" value="&lt;b&gt;EcoleAccreditationController&lt;/b&gt; [NOUVEAU]&lt;hr&gt;/api/accreditation/ecole/**&lt;hr&gt;soumettreDemande() - cree le profil + la demande,&lt;br&gt;accorde ROLE_ECOLE_FORMATION a la 1re soumission&lt;br&gt;mesDemandes() / demande() / televerserPiece()&lt;br&gt;telechargerPiece()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="460" width="320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="evaluateur-controller" value="&lt;b&gt;EvaluateurAccreditationController&lt;/b&gt; [NOUVEAU]&lt;hr&gt;/api/admin/accreditation/**&lt;br&gt;hasRole('EVALUATEUR_ACCREDITATION')&lt;hr&gt;demandes() / prendreEnCharge() / accrediter() /&lt;br&gt;rejeter() (motif obligatoire) / CRUD criteres" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="public-controller" value="&lt;b&gt;AccreditationPublicController&lt;/b&gt; [NOUVEAU]&lt;hr&gt;/api/accreditation/public/**, permitAll()&lt;hr&gt;ecolesAccreditees() - EcoleAccrediteeDto&lt;br&gt;(nomEcole + dateAccreditation seulement,&lt;br&gt;jamais adresse/telephone/email)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1080" y="460" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="storage-service" value="&lt;b&gt;PieceAccreditationStorageService&lt;/b&gt; [NOUVEAU]&lt;hr&gt;Patron PhotoStorageService/AlumniDocumentStorageService&lt;br&gt;ValidationFichier.EXTENSIONS_SUPPORT_COURS&lt;br&gt;(PDF/Word/PowerPoint/Excel/images) - hors public/" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="650" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="notification-service" value="&lt;b&gt;AccreditationNotificationService&lt;/b&gt; [NOUVEAU]&lt;hr&gt;JavaMailSender, sujet [INPG Accreditation]&lt;br&gt;notifierNouvelleDemande / PriseEnCharge /&lt;br&gt;Accreditation / Rejet" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="760" y="650" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- Relations -->
        <mxCell id="rel-ecole-demande" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ecole-formation" target="demande-accreditation">
