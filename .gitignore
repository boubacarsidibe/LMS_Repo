# ===================== Secrets =====================
# Aucun fichier d'environnement ne doit être versionné : la seule exception est
# le modèle .env.example, qui ne contient que des clés vides.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ===================== Journaux =====================
*.log
# Rapports de plantage et de replay de la JVM (générés dans le dossier courant
# au moment du crash, propres au poste qui les a produits).
hs_err_pid*.log
replay_pid*.log
hs_err_pid*
replay_pid*

# ===================== Build =====================
target/
dist/
node_modules/
build/

# Artefacts locaux Maven et fichiers temporaires créés au démarrage de la JVM.
# Ils dépendent du poste et ne doivent jamais être ajoutés au dépôt.
backend/.m2-repository/
backend/.runtime-tmp/

# ===================== Données d'exécution =====================
# Fichiers déposés par l'application (supports de cours, pièces justificatives,
# photos). En conteneur ils vivent dans le volume Docker « backend_uploads » ;
# ce dossier n'apparaît en local que si l'on lance le backend hors Docker.
uploads/

# ===================== Surcharges locales =====================
# Fichiers d'aide au test en local (non partagés) : override Compose servant le
# frontend en statique derrière nginx, et son Dockerfile/conf associés.
docker-compose.override.yml
frontend/Dockerfile.local
frontend/nginx.local.conf

# ===================== Outils / IDE =====================
.DS_Store
Thumbs.db
*.iml
.idea/
# Configuration locale de l'assistant IA (permissions, préférences de poste) :
# propre à chaque développeur, pas à partager sur le dépôt.
.claude/

# ===================== Documents de travail =====================
# Rapports hebdomadaires et exports bureautiques : livrables de suivi, pas du code.
~$*.xlsx
~$*.docx
.local-postgres/
.tmp-weekly-reports/
outputs/

.vercel

# Modèle de certificat INPG d'origine : porte les données d'une personne réelle, seul le fond vierge
# (backend/src/main/resources/certificats/) est versionné.
backend/Mod*le Certificat INPG.pdf

# Questionnaire de collecte de données rempli par le personnel de l'INPG (2026-09-30) : porte des téléphones
# et e-mails de personnes. Ce qu'on en retient est consigné dans docs/COLLECTE_DONNEES_INPG_2026-10-12.md.
/infos1.pdf
